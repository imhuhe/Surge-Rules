#!name = 美团净化
#!desc = 埋点上报整域静默 + 广告营销位清空。基于 2026-07-21 iPhone 实测抓包(828条)重制。策略比高德保守：美团每个 tab 都是真实交易入口(外卖/团购/支付)，只清广告与遥测，不做整 tab 封杀。HTTPDNS 拦截在 HTTPDNS.list 内维护，不在本模块重复。
#!category = 广告拦截
#!openUrl = https://apps.apple.com/app/id423084029

[Map Local]
# —— 埋点上报整域静默：149 条 *.d.meituan.net 实测全为 POST 到根路径，无 GET 资源，整域安全 ——
^https?:\/\/[\w-]+\.d\.meituan\.net\/ data-type=text data="{\"code\":0,\"msg\":\"\",\"data\":null}" status-code=200 header="Content-Type:application/json"

# —— 美团 LX 统计 SDK：上行流量第一名(31次/191KB) ——
^https?:\/\/lx0?\.meituan\.(?:com|net)\/ data-type=text data="{\"code\":0,\"msg\":\"\",\"data\":null}" status-code=200 header="Content-Type:application/json"

# —— 点评 CAT 监控埋点 ——
^https?:\/\/cat(?:front|dot)\.dianping\.com\/ data-type=text data="{\"code\":0,\"msg\":\"\",\"data\":null}" status-code=200 header="Content-Type:application/json"
^https?:\/\/mlog\.dianping\.com\/ data-type=text data="{\"code\":0,\"msg\":\"\",\"data\":null}" status-code=200 header="Content-Type:application/json"

# —— 其余上报通道 ——
^https?:\/\/d?report\.meituan\.(?:com|net)\/ data-type=text data="{\"code\":0,\"msg\":\"\",\"data\":null}" status-code=200 header="Content-Type:application/json"
# msp/affogato: 净化前实测 in=329 out=38373，带 csec* 参数(美团客户端安全SDK设备指纹采集)，
# 纯上报无疑，下行仅为 ack。曾一度怀疑是数据下发而放行，经原始样本证伪，恢复拦截。
^https:\/\/msp\.meituan\.com\/api\/affogato data-type=text data="{\"code\":0,\"msg\":\"\",\"data\":null}" status-code=200 header="Content-Type:application/json"
^https:\/\/sessions\.bugsnag\.com\/ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

# —— 广告：蒲公英(pgy)广告平台 曝光回调与竞价交换 ——
^https:\/\/market-fin\.meituan\.com\/ad\/ data-type=text data="{\"code\":0,\"msg\":\"\",\"data\":null}" status-code=200 header="Content-Type:application/json"
^https:\/\/mgm\.meituan\.com\/marketing\/ data-type=text data="{\"code\":0,\"msg\":\"\",\"data\":null}" status-code=200 header="Content-Type:application/json"

# —— 钱包底部横幅 + 弹窗频控上报 ——
^https:\/\/npay\.meituan\.com\/(?:conch\/wallet\/bottom-banner|api\/flow-distribute\/frequency\/report) data-type=text data="{\"code\":0,\"msg\":\"\",\"data\":null}" status-code=200 header="Content-Type:application/json"

# —— 骚扰问卷 ——
^https:\/\/cem\.meituan\.com\/survey\/ data-type=text data="{\"code\":0,\"msg\":\"\",\"data\":null}" status-code=200 header="Content-Type:application/json"

# —— 广告图源静默：返回 1x1 透明 GIF ——
# /adunion/=广告联盟素材, /recommendimage/=推荐位素材，均为广告专用路径；
# 正常内容图走 /deal/ /dealpic/ /content/ /channelpictures/ 等其他前缀，不受影响。
# 局限：只让图消失，卡片骨架仍在(表现为空白块)。API 层剔除见下方 Body Rewrite。
^https?:\/\/p\d\.meituan\.net\/adunion\/ data-type=base64 data="R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" status-code=200 header="Content-Type:image/gif"
^https?:\/\/p\d\.meituan\.net\/recommendimage\/ data-type=base64 data="R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" status-code=200 header="Content-Type:image/gif"

[Body Rewrite]
# —— 首页团购瀑布流：剔除付费广告卡片，保留自然结果 ——
# 实测 9 张卡片中 6 张 adInfo.type=="default" 且带 impressionUrl(曝光计费)，全是高客单价广告位；
# 自然结果 adInfo 为空。删 item 而非整接口，顶层 32 个字段与分页信息保持不变。
http-response-jq ^https:\/\/apimobile\.meituan\.com\/group\/v4\/poi\/tuan\/list\/ '(.gathers[]?.items) |= map(select(.adInfo.type != "default"))'

# —— 支付完成后的"你可能还喜欢"弹窗推荐(valLab.position=pay_popup) ——
http-response-jq ^https:\/\/apimobile\.meituan\.com\/group\/v1\/recommend\/unity\/recommends '.data = []'

# —— "我的"页工具区：生活工具/公益与互助/与美团合作 共3组12项，整组清空 ——
http-response-jq ^https:\/\/mt-personalcenter\.meituan\.com\/secondPage\/tool '.data = []'

[MITM]
hostname = %APPEND% lx0.meituan.com, lx.meituan.net, *.d.meituan.net, catfront.dianping.com, catdot.dianping.com, mlog.dianping.com, report.meituan.com, dreport.meituan.net, msp.meituan.com, market-fin.meituan.com, mgm.meituan.com, npay.meituan.com, cem.meituan.com, sessions.bugsnag.com, apimobile.meituan.com, mt-personalcenter.meituan.com, p0.meituan.net, p1.meituan.net, p2.meituan.net

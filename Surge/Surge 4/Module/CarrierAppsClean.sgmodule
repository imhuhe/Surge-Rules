#!name = 运营商 App 净化（移动 / 联通）
#!desc = 干掉中国移动、中国联通 App 的开屏广告与首页广告位。开屏部分基于 QingRex/LoonKissSurge 与墨鱼规则整合重制，2026-08-28 建。⚠️ 首页牛皮癣与各省分公司接口尚未抓包补全，位置权限弹窗属本地 UI，网络层拦不掉——见文末说明。
#!category = 广告拦截

# ══════════════════════════════════════════
#  中国联通  m.client.10010.com
# ══════════════════════════════════════════
# 联通 App 走非标准 HTTP 引擎，不加这行 MITM 会静默失效
[General]
force-http-engine-hosts = %APPEND% m.client.10010.com

[Map Local]
# —— 联通：开屏广告 ——
# accountListData.htm 同时下发账户数据与开屏广告，不能整条返空，
# 只能按原结构把 startup_adv 置空，保住 respCode 与 imgIndex
^https?:\/\/m\.client\.10010\.com\/mobileService\/customer\/accountListData\.htm data-type=text data="{\"imgIndex\":\"0\",\"adv\":{\"startup_adv\":{\"advCntList\":[],\"buttonList\":[]}},\"respCode\":\"0000\"}" status-code=200 header="Content-Type:application/json"

# —— 联通：其余纯广告接口，整条返空 ——
^https?:\/\/m\.client\.10010\.com\/mobileService\/(?:activity|customer)\/(?:get_client_adv|get_startadv) data-type=text data="{\"respCode\":\"0000\"}" status-code=200 header="Content-Type:application/json"
^https?:\/\/m\.client\.10010\.com\/uniAdmsInterface\/(?:getHomePageAd|getWelcomeAd) data-type=text data="{\"respCode\":\"0000\"}" status-code=200 header="Content-Type:application/json"

# ══════════════════════════════════════════
#  中国移动  *.10086.cn
# ══════════════════════════════════════════
# —— 移动：全国统一开屏（主力，各省通用）——
# ⚠️ startInit 是"启动初始化"接口，公开规则流传已久判定安全，但本机未实测。
#    若装上后 App 首页异常/白屏，第一个怀疑对象就是这条。
^https?:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/DN\/init\/startInit data-type=text data="{\"code\":\"0\",\"data\":{}}" status-code=200 header="Content-Type:application/json"

# —— 移动：各省分公司开屏（只覆盖已知四省，其余需抓包补）——
^https?:\/\/wap\.js\.10086\.cn\/jsmccClient\/cd\/market_content\/api\/v\d\/market_content\.page\.query data-type=text data="{\"code\":\"0\",\"data\":{}}" status-code=200 header="Content-Type:application/json"
^https?:\/\/m\.sd\.10086\.cn\/zapi\/app_common\/homeWelcome\/welcome\.do data-type=text data="{\"code\":\"0\",\"data\":{}}" status-code=200 header="Content-Type:application/json"
^https?:\/\/gx\.10086\.cn\/zt-portal\/gxhzg\/portal\/app\/api\/v data-type=text data="{\"code\":\"0\",\"data\":{}}" status-code=200 header="Content-Type:application/json"
^https?:\/\/gd\.10086\.cn\/gmccapp\/serv\/\?servicename=GMCCAPP_704_002_001_001 data-type=text data="{\"code\":\"0\",\"data\":{}}" status-code=200 header="Content-Type:application/json"

# —— 移动：周边产品广告 ——
^https?:\/\/ad\.mcloud\.139\.com\/ data-type=text data="{\"code\":\"0\",\"data\":{}}" status-code=200 header="Content-Type:application/json"
^https?:\/\/smsrebuild1\.mail\.10086\.cn\/together\/s data-type=text data="{\"code\":\"0\",\"data\":{}}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% m.client.10010.com, client.app.coc.10086.cn, wap.js.10086.cn, m.sd.10086.cn, gx.10086.cn, gd.10086.cn, ad.mcloud.139.com, smsrebuild1.mail.10086.cn

# ══════════════════════════════════════════
#  本模块拦不掉的三类，别指望
# ══════════════════════════════════════════
# 1. 位置权限弹窗：App 本地代码弹的（系统 alert 或自绘说明页），不发网络请求，
#    Surge 够不着。只能在 iOS 设置 → 隐私与安全性 → 定位服务 → 该 App → 永不。
# 2. 首页运营位/牛皮癣：联通有 queryIndexWaterfall、queryIndexExclusiveOffers
#    两个接口是广告与内容混发，要用 Body Rewrite 精确删字段，必须先抓包看真实
#    结构。上游那份用 walk() 无差别清空所有数组，会连正常内容一起清掉，不采用。
# 3. 各省分公司自有开屏：域名形如 <省缩写>.10086.cn，路径各省不同，无法通配。

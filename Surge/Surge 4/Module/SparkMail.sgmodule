[Script]
Spark.Mail = type=http-response,pattern=^https?:\/\/api\.revenuecat\.com\/v1\/(receipts|subscribers\/[^\/\?]+)(\?.*)?$,requires-body=1,max-size=-1,script-path=https://cdn.jsdelivr.net/gh/imhuhe/Surge-Rules@main/Surge/Surge%204/Script/SparkMail.response.js

[MITM]
hostname = %APPEND% api.revenuecat.com
